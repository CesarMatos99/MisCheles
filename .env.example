# Firebase client configuration (public app identifiers only; never place OAuth secrets here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# Enable only after registering the web app and reCAPTCHA v3 provider in Firebase App Check.
VITE_FIREBASE_APPCHECK_ENABLED=false
VITE_FIREBASE_APPCHECK_SITE_KEY=
