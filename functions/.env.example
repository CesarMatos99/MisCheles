# Public OAuth client IDs and registered HTTPS callback URLs (no client secrets here).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=
# Configure each redirect URI as the deployed completeMailOAuth HTTPS URL in provider consoles.
# MAIL_TOKEN_KEYRING is a Firebase Secret, JSON: {"activeKeyId":"v1","keys":{"v1":"<32-byte-key-base64url>"}}.
